{
  "name": "b2b-rfq-marketplace",
  "version": "1.0.0",
  "description": "Full-Stack B2B Request for Quotation (RFQ) Marketplace",
  "main": "index.js",
  "scripts": {
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "seed": "npm --prefix server run seed",
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "node server/server.js"
  },
  "keywords": ["b2b", "rfq", "marketplace", "mern"],
  "author": "Aanshikesh Rawat",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
